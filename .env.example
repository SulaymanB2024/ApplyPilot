# ApplyPilot Environment Configuration
# Copy to your ApplyPilot data directory .env and fill in your values.
# API keys can also be stored in the OS keyring via applypilot init.

# LLM Provider (pick one for the legacy scoring/tailoring pipeline)
GEMINI_API_KEY=           # Gemini 2.0 Flash (recommended, cheapest)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Tool-first ChatGPT Web autonomy (does not expose an API key)
# APPLYPILOT_LLM_PROVIDER=chatgpt_web

# Auto-Apply (optional)
# APPLYPILOT_AGENT_BACKEND=codex   # deterministic controller; legacy Claude path is disabled
# APPLYPILOT_EXECUTOR_MODEL=gpt-5.5
# APPLYPILOT_SUPERVISOR_MODEL=gpt-5.5
# APPLYPILOT_SUPERVISOR_POLL_SECONDS=60
# APPLYPILOT_DETERMINISTIC_CONTROLLER=1
# APPLYPILOT_FIELD_MODEL_CALL_BUDGET=0  # 0 by default; max 2 schema-constrained calls per job
# Job-site account creation is intentionally authorized per run with --allow-account-creation.
# APPLYPILOT_CREDENTIAL_PROVIDER=google_password_manager  # google_password_manager, onepassword, or none
# APPLYPILOT_CHROME_PROFILE_DIRECTORY= # Optional Chrome profile containing Google Password Manager credentials
# APPLYPILOT_ONEPASSWORD_ENABLED=0      # Legacy opt-in; prefer APPLYPILOT_CREDENTIAL_PROVIDER=onepassword
# APPLYPILOT_ONEPASSWORD_VAULT=         # Optional 1Password vault name/id for legacy job-site logins
# APPLYPILOT_ONEPASSWORD_EXTENSION_ID=aeblfdkhhhdcdjpifhhbdiojplfjncoa

# Self-improvement development harness (optional)
# APPLYPILOT_DEV_MODE=dry-run
# APPLYPILOT_DEV_WORKER_MODEL=gpt-5.5
# APPLYPILOT_DEV_REVIEWER_MODEL=gpt-5.5
# APPLYPILOT_DEV_FORBIDDEN_MODELS=gpt-5.3-codex-spark

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
